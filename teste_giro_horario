#include <Wire.h>
#include <Keypad.h>
#include <LiquidCrystal_I2C.h>
#include <TM1637TinyDisplay.h>

// ==================== LCD I2C ====================
LiquidCrystal_I2C lcd(0x27, 16, 2);

// ==================== DISPLAY TM1637 ====================
const int TM_CLK_PIN = 4;
const int TM_DIO_PIN = 5;

TM1637TinyDisplay displayAngulo(TM_CLK_PIN, TM_DIO_PIN);

// ==================== MOTOR NEMA 17 + DRIVER A4988 ====================
const int STEP_PIN = 16;
const int DIR_PIN  = 17;
const int EN_PIN   = 18;   // ativo em LOW

// false: DIR HIGH = sentido positivo
// true : DIR LOW  = sentido positivo (inverte a rotacao do motor)
// O sentido positivo e o usado no modo automatico e na ordem das fases.
// Ele deve girar ANTI-HORARIO (visto de cima), como a orbita da Lua.
// Se girar horario no teste, troque para true.
const bool INVERTER_DIRECAO = false;

// NEMA 17: 200 passos/volta. Com microstepping 1/16
// (MS1 = MS2 = MS3 = 3V3 no A4988): 3200 passos/volta.
const int PASSOS_VOLTA = 3200;
const int PASSOS_FASE = PASSOS_VOLTA / 4;  // 800

// Atraso entre passos nos movimentos manuais (us)
const unsigned int ATRASO_PASSO_US = 500;

// Desvio artificial (5% da volta = 18 graus)
const int PASSOS_DESVIO = 160;

// ==================== VELOCIDADE (MODO AUTOMATICO) ====================
// Intervalo entre passos em microssegundos.
const unsigned long INTERVALO_MEDIO_US  = 1000UL;
const unsigned long INTERVALO_MAXIMO_US = 300UL;

// Tempo que a tela de velocidade fica visivel no modo automatico
const unsigned long TEMPO_TELA_VELOCIDADE_MS = 900;

// ==================== TECLADO 4x4 ====================
const byte ROWS = 4;
const byte COLS = 4;

char keys[ROWS][COLS] = {
  {'1', '2', '3', 'A'},
  {'4', '5', '6', 'B'},
  {'7', '8', '9', 'C'},
  {'*', '0', '#', 'D'}
};

byte rowPins[ROWS] = {32, 33, 25, 26};
byte colPins[COLS] = {27, 14, 13, 23};

Keypad teclado = Keypad(
  makeKeymap(keys),
  rowPins,
  colPins,
  ROWS,
  COLS
);

// ==================== FASES DA LUA ====================
const char* fases[4] = {
  "Lua nova",
  "Quarto crescente",
  "Lua cheia",
  "Quarto minguante"
};

// ==================== ESTADO DO SISTEMA ====================
int posicao = 0;
int faseAtual = 0;

bool modoAutomatico = false;
bool mostrandoVelocidadeLCD = false;

// false = velocidade media (*) | true = velocidade maxima (#)
bool velocidadeMaxima = false;

unsigned long intervaloPassoAutoUs = INTERVALO_MEDIO_US;

unsigned long ultimoPassoAutoUs = 0;
unsigned long instanteTelaVelocidadeMs = 0;

unsigned long ultimaAtualizacaoDisplayMs = 0;
long ultimoValorDisplay = -1;

// ======================================================
// EXIBICAO NO LCD
// ======================================================

void mostrarMensagem(const char* linha1, const char* linha2) {
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print(linha1);

  lcd.setCursor(0, 1);
  lcd.print(linha2);
}

void mostrarFase(int fase) {
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Fase da Lua:");

  lcd.setCursor(0, 1);
  lcd.print(fases[fase]);
}

void mostrarVelocidade() {
  char linha2[17];

  snprintf(
    linha2,
    sizeof(linha2),
    "%s (%lu us)",
    velocidadeMaxima ? "Maxima" : "Media",
    intervaloPassoAutoUs
  );

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Velocidade:");

  lcd.setCursor(0, 1);
  lcd.print(linha2);
}

// ======================================================
// EXIBICAO DO ANGULO NO TM1637 (3 ULTIMOS DIGITOS)
// ======================================================

void mostrarAngulo(bool forcar = false) {
  unsigned long agora = millis();

  if (!forcar && agora - ultimaAtualizacaoDisplayMs < 80) {
    return;
  }

  // Angulo em graus inteiros (0 a 359), arredondado.
  long angulo =
    ((long)posicao * 360L + PASSOS_VOLTA / 2)
    / PASSOS_VOLTA;

  if (angulo >= 360) {
    angulo = 0;
  }

  if (!forcar && angulo == ultimoValorDisplay) {
    return;
  }

  ultimaAtualizacaoDisplayMs = agora;
  ultimoValorDisplay = angulo;

  // Usa so os 3 ultimos digitos (posicoes 1 a 3),
  // com zeros a esquerda e sem ponto decimal.
  displayAngulo.showNumberDec(
    (int)angulo,
    0,
    true,
    3,
    1
  );
}

// ======================================================
// CONTROLE DO MOTOR (A4988)
// ======================================================

void habilitarDriver() {
  digitalWrite(EN_PIN, LOW);
}

void desabilitarDriver() {
  digitalWrite(EN_PIN, HIGH);
}

// direcao > 0: sentido positivo | direcao < 0: sentido contrario
void darPasso(int direcao) {
  bool nivelDir = (direcao > 0);

  if (INVERTER_DIRECAO) {
    nivelDir = !nivelDir;
  }

  digitalWrite(DIR_PIN, nivelDir ? HIGH : LOW);
  habilitarDriver();

  // Pulso de STEP (minimo de 1 us no A4988)
  digitalWrite(STEP_PIN, HIGH);
  delayMicroseconds(5);
  digitalWrite(STEP_PIN, LOW);
}

void moverPassos(int quantidade) {
  if (quantidade == 0) {
    return;
  }

  int direcao = (quantidade > 0) ? 1 : -1;
  int total = abs(quantidade);

  for (int i = 0; i < total; i++) {
    darPasso(direcao);
    delayMicroseconds(ATRASO_PASSO_US);

    posicao += direcao;

    if (posicao >= PASSOS_VOLTA) {
      posicao = 0;
    }

    if (posicao < 0) {
      posicao = PASSOS_VOLTA - 1;
    }

    mostrarAngulo();
  }

  desabilitarDriver();

  mostrarAngulo(true);
}

// ======================================================
// SELECAO MANUAL DAS FASES
// ======================================================

void selecionarFase(int novaFase) {
  if (modoAutomatico) {
    desabilitarDriver();
  }

  modoAutomatico = false;
  mostrandoVelocidadeLCD = false;

  faseAtual = novaFase % 4;

  if (faseAtual < 0) {
    faseAtual += 4;
  }

  int destino = faseAtual * PASSOS_FASE;
  int diferenca = destino - posicao;

  // Escolhe o caminho mais curto.
  if (diferenca > PASSOS_VOLTA / 2) {
    diferenca -= PASSOS_VOLTA;
  }

  if (diferenca < -PASSOS_VOLTA / 2) {
    diferenca += PASSOS_VOLTA;
  }

  mostrarMensagem("Movendo para:", fases[faseAtual]);

  moverPassos(diferenca);

  mostrarFase(faseAtual);
}

// ======================================================
// DESVIO SIMULADO
// ======================================================

void provocarDesvio() {
  if (modoAutomatico) {
    desabilitarDriver();
  }

  modoAutomatico = false;
  mostrandoVelocidadeLCD = false;

  moverPassos(PASSOS_DESVIO);

  faseAtual = posicao / PASSOS_FASE;

  mostrarMensagem("Desvio simulado", "160 passos");
}

// ======================================================
// AJUSTE DE VELOCIDADE PELO TECLADO
// ======================================================

// '*' = velocidade media | '#' = velocidade maxima.
void definirVelocidade(bool maxima) {
  velocidadeMaxima = maxima;

  intervaloPassoAutoUs =
    maxima ? INTERVALO_MAXIMO_US : INTERVALO_MEDIO_US;

  mostrarVelocidade();

  if (modoAutomatico) {
    mostrandoVelocidadeLCD = true;
    instanteTelaVelocidadeMs = millis();
  }
}

// ======================================================
// MODO AUTOMATICO
// ======================================================

void iniciarAutomatico() {
  if (modoAutomatico) {
    // D desliga o modo automatico.
    modoAutomatico = false;
    mostrandoVelocidadeLCD = false;

    desabilitarDriver();
    mostrarAngulo(true);

    mostrarFase(faseAtual);
    return;
  }

  modoAutomatico = true;
  mostrandoVelocidadeLCD = false;

  intervaloPassoAutoUs =
    velocidadeMaxima ? INTERVALO_MAXIMO_US : INTERVALO_MEDIO_US;

  ultimoPassoAutoUs = micros();

  mostrarFase(faseAtual);
}

void atualizarAutomatico() {
  if (!modoAutomatico) {
    return;
  }

  unsigned long agora = millis();

  if (
    mostrandoVelocidadeLCD &&
    agora - instanteTelaVelocidadeMs >=
      TEMPO_TELA_VELOCIDADE_MS
  ) {
    mostrandoVelocidadeLCD = false;
    mostrarFase(faseAtual);
  }

  mostrarAngulo();

  unsigned long agoraUs = micros();

  if (agoraUs - ultimoPassoAutoUs >= intervaloPassoAutoUs) {
    ultimoPassoAutoUs = agoraUs;

    // Sentido positivo no modo automatico.
    darPasso(1);

    posicao++;

    if (posicao >= PASSOS_VOLTA) {
      posicao = 0;
    }

    mostrarAngulo();

    int novaFase = posicao / PASSOS_FASE;

    if (novaFase != faseAtual) {
      faseAtual = novaFase;

      if (!mostrandoVelocidadeLCD) {
        mostrarFase(faseAtual);
      }
    }
  }
}

// ======================================================
// SETUP
// ======================================================

void setup() {
  pinMode(STEP_PIN, OUTPUT);
  pinMode(DIR_PIN, OUTPUT);
  pinMode(EN_PIN, OUTPUT);
  digitalWrite(STEP_PIN, LOW);
  digitalWrite(DIR_PIN, LOW);
  desabilitarDriver();

  // LCD I2C: SDA = GPIO 21; SCL = GPIO 22.
  Wire.begin(21, 22);

  lcd.init();
  lcd.backlight();

  displayAngulo.begin();
  displayAngulo.setBrightness(4);
  displayAngulo.clear();

  mostrarMensagem("Simulador lunar", "Sistema pronto");
  mostrarAngulo(true);
}

// ======================================================
// LOOP PRINCIPAL
// ======================================================

void loop() {
  char tecla = teclado.getKey();

  if (tecla == 'A') {
    selecionarFase(faseAtual + 1);
  }
  else if (tecla == 'B') {
    selecionarFase(faseAtual - 1);
  }
  else if (tecla == 'C') {
    provocarDesvio();
  }
  else if (tecla == 'D') {
    iniciarAutomatico();
  }
  else if (tecla == '*') {
    definirVelocidade(false);  // velocidade media
  }
  else if (tecla == '#') {
    definirVelocidade(true);   // velocidade maxima
  }

  atualizarAutomatico();
}
